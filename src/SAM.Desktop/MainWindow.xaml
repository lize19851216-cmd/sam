<Window x:Class="SAM.Desktop.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="SAM - Steam Account Manager M3" Height="720" Width="1180"
 WindowStartupLocation="CenterScreen">
 <DockPanel Margin="12">
   <Border DockPanel.Dock="Top" Padding="12" Margin="0,0,0,10" BorderThickness="1" BorderBrush="Gray">
     <StackPanel>
     <StackPanel Orientation="Horizontal">
       <TextBlock Text="SAM Milestone 3" FontSize="24" FontWeight="Bold" VerticalAlignment="Center"/>
       <TextBlock x:Name="EnvironmentText" Text="   模拟环境" VerticalAlignment="Center"/>
       <TextBlock Text="   并发:" VerticalAlignment="Center" Margin="30,0,4,0"/>
       <TextBox x:Name="ConcurrencyBox" Text="10" Width="55" Padding="5"/>
       <Button x:Name="Generate100Button" Content="生成100账号" Click="Generate100_Click" Margin="20,0,5,0" Padding="12,5"/>
       <Button x:Name="Generate500Button" Content="生成500账号" Click="Generate500_Click" Margin="5,0" Padding="12,5"/>
       <Button x:Name="DeleteSelectedAccountButton" Content="删除选中账号" Click="DeleteSelectedAccount_Click" Margin="5,0" Padding="12,5"/>
       <Button x:Name="ClearAccountsButton" Content="清空账号列表" Click="ClearAccounts_Click" Margin="5,0" Padding="12,5"/>
       <Button x:Name="LoginButton" Content="批量模拟登录" Click="Login_Click" Margin="5,0" Padding="12,5"/>
       <Button x:Name="CancelButton" Content="取消任务" Click="Cancel_Click" Margin="5,0" Padding="12,5" IsEnabled="False"/>
       <Button Content="加载插件" Click="LoadPlugins_Click" Margin="5,0" Padding="12,5"/>
     </StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
       <TextBlock Text="认证客户端:" VerticalAlignment="Center"/>
       <ComboBox x:Name="ClientModeBox" Width="130" SelectedIndex="0" SelectionChanged="ClientModeBox_SelectionChanged" Margin="6,0,0,0">
         <ComboBoxItem Content="模拟客户端"/>
         <ComboBoxItem Content="外部认证代理"/>
       </ComboBox>
       <TextBlock Text="本地管道:" VerticalAlignment="Center" Margin="16,0,4,0"/>
       <TextBox x:Name="BrokerPipeNameBox" Text="sam-steam-auth" Width="180" Padding="5" IsEnabled="False"/>
       <Button x:Name="ApplyClientModeButton" Content="应用认证设置" Click="ApplyClientMode_Click" Margin="6,0,0,0" Padding="10,4"/>
       <Button x:Name="TestBrokerButton" Content="测试代理连接" Click="TestBroker_Click" Margin="6,0,0,0" Padding="10,4" IsEnabled="False"/>
       <TextBlock Text="仅连接当前用户的本地代理；SAM 不接收或存储凭据" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="DimGray"/>
     </StackPanel>
     <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
       <TextBlock Text="单账号真实测试:" VerticalAlignment="Center"/>
       <TextBox x:Name="RealAccountNameBox" Width="180" Padding="5" Margin="6,0,0,0" IsEnabled="False"/>
       <Button x:Name="SaveSingleAccountButton" Content="保存单账号测试" Click="SaveSingleAccount_Click" Margin="6,0,0,0" Padding="10,4" IsEnabled="False"/>
       <TextBlock Text="仅保存账号名并替换本地模拟列表；登录时在本地 Broker 窗口扫描一次性 Steam QR 码" VerticalAlignment="Center" Margin="12,0,0,0" Foreground="DimGray"/>
     </StackPanel>
     </StackPanel>
   </Border>
   <StatusBar DockPanel.Dock="Bottom">
     <TextBlock x:Name="StatusText" Text="就绪"/>
   </StatusBar>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="2*"/><RowDefinition Height="*"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DataGrid x:Name="AccountsGrid" AutoGenerateColumns="False" IsReadOnly="True">
     <DataGrid.Columns>
       <DataGridTextColumn Header="账号" Binding="{Binding AccountName}" Width="2*"/>
       <DataGridTextColumn Header="SteamID" Binding="{Binding SteamId}" Width="2*"/>
       <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*"/>
       <DataGridTextColumn Header="重试" Binding="{Binding RetryCount}" Width="70"/>
       <DataGridTextColumn Header="信息" Binding="{Binding LastMessage}" Width="3*"/>
     </DataGrid.Columns>
    </DataGrid>
    <GroupBox Grid.Row="1" Header="Task Center" Margin="0,10,0,0">
     <DockPanel>
     <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,6,0,0">
      <Button x:Name="LoadMoreTasksButton" Content="加载更多任务历史" Click="LoadMoreTasks_Click" Padding="10,4" IsEnabled="False"/>
      <Button x:Name="PruneTaskHistoryButton" Content="清理超过90天的终态历史" Click="PruneTaskHistory_Click" Padding="10,4" Margin="6,0,0,0"/>
     </StackPanel>
     <DataGrid x:Name="TasksGrid" AutoGenerateColumns="False" IsReadOnly="True">
      <DataGrid.Columns>
       <DataGridTextColumn Header="类型" Binding="{Binding TaskType}" Width="*"/>
       <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="*"/>
       <DataGridTextColumn Header="重试" Binding="{Binding RetryCount}" Width="70"/>
       <DataGridTextColumn Header="信息" Binding="{Binding Message}" Width="3*"/>
       <DataGridTextColumn Header="更新时间" Binding="{Binding UpdatedAt}" Width="2*"/>
      </DataGrid.Columns>
     </DataGrid>
     </DockPanel>
    </GroupBox>
    <GroupBox Grid.Row="2" Header="Plugins" Margin="0,10,0,0">
     <DockPanel>
     <Button DockPanel.Dock="Bottom" Content="复制选中插件哈希" Click="CopySelectedPluginHash_Click" Padding="10,4" Margin="0,6,0,0"/>
     <DataGrid x:Name="PluginsGrid" AutoGenerateColumns="False" IsReadOnly="True">
      <DataGrid.Columns>
       <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="2*"/>
       <DataGridTextColumn Header="名称" Binding="{Binding Name}" Width="2*"/>
       <DataGridTextColumn Header="版本" Binding="{Binding Version}" Width="*"/>
       <DataGridTextColumn Header="状态" Binding="{Binding Status}" Width="3*"/>
       <DataGridTextColumn Header="SHA-256" Binding="{Binding Hash}" Width="3*"/>
      </DataGrid.Columns>
     </DataGrid>
     </DockPanel>
    </GroupBox>
   </Grid>
 </DockPanel>
</Window>
